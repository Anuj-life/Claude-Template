---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// This automatically pulls in EVERY .md file from src/content/songs
// You never need to edit this file when you add a new song.
const allSongs = await getCollection('songs');
const sorted = allSongs.sort((a, b) => (a.data.title > b.data.title ? 1 : -1));
---
<Layout title="Home">
  <h1>Welcome to Hindi Christian Song</h1>
  <p>
    A collection of Hindi Christian bhajans and worship song lyrics —
    made to help you sing and worship in your own language.
  </p>
  <p>
    <a href="/blog/" class="cta-button">Browse All Songs</a>
  </p>
</Layout>
